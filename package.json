{
  "name": "flipbook",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "release:build": "npm test && npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "lucide-react": "^0.468.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "description": "A local-first PDF magazine reader with realistic page turns, selectable text and interactive paper stacks.",
  "license": "MIT",
  "author": "Pragith Prakash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pragith/flipbook.git"
  },
  "homepage": "https://github.com/Pragith/flipbook#readme",
  "bugs": {
    "url": "https://github.com/Pragith/flipbook/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
